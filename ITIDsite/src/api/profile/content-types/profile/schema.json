{
  "kind": "collectionType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "text"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "responsibilities": {
      "type": "text"
    },
    "room": {
      "type": "text"
    },
    "address": {
      "type": "text"
    },
    "phone": {
      "type": "text"
    },
    "webpage": {
      "type": "text"
    },
    "linkedin": {
      "type": "text"
    },
    "teams": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::team.team",
      "inversedBy": "profiles"
    },
    "profile_picture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
